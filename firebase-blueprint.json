{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Beneficiary profile with demographic, educational, and livelihood data",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "education": { "type": "string", "maxLength": 100 },
        "skills": { "type": "string", "maxLength": 500 },
        "interests": { "type": "string", "maxLength": 500 },
        "occupation": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 150 },
        "workType": { "type": "string", "maxLength": 50 },
        "mobility": { "type": "string", "maxLength": 100 },
        "consentSaved": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["location", "updatedAt"]
    },
    "Opportunity": {
      "title": "Opportunity",
      "description": "Hyperlocal livelihood job or self-employment opportunity",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "org": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["Job", "Self-employment", "Training"] },
        "loc": { "type": "string", "maxLength": 200 },
        "district": { "type": "string", "maxLength": 100 },
        "km": { "type": "number" },
        "pay": { "type": "string", "maxLength": 100 },
        "path": { "type": "string", "maxLength": 100 },
        "verified": { "type": "boolean" },
        "source": { "type": "string", "maxLength": 200 },
        "lastVerifiedDate": { "type": "string", "maxLength": 50 },
        "eligibility": { "type": "string", "maxLength": 500 },
        "contactInfo": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "org", "type", "loc"]
    },
    "TrainingCenter": {
      "title": "TrainingCenter",
      "description": "Certified PMKVY, RSETI, or ITI skill training center",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "org": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["Training"] },
        "loc": { "type": "string", "maxLength": 200 },
        "district": { "type": "string", "maxLength": 100 },
        "km": { "type": "number" },
        "pay": { "type": "string", "maxLength": 100 },
        "path": { "type": "string", "maxLength": 100 },
        "verified": { "type": "boolean" },
        "source": { "type": "string", "maxLength": 200 },
        "lastVerifiedDate": { "type": "string", "maxLength": 50 },
        "eligibility": { "type": "string", "maxLength": 500 },
        "contactInfo": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "org", "loc"]
    },
    "Pathway": {
      "title": "Pathway",
      "description": "NSQF-aligned career pathway and progression roadmap",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "hi": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 200 },
        "duration": { "type": "string", "maxLength": 100 },
        "nsqf": { "type": "number" },
        "minEdu": { "type": "number" },
        "demand": { "type": "number" },
        "demandNote": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "name", "role"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Cloudinary-hosted banner, scheme, training gallery, job, or avatar media record",
      "type": "object",
      "properties": {
        "url": { "type": "string", "maxLength": 1000 },
        "folder": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 200 },
        "tags": { "type": "array" },
        "used": { "type": "number" },
        "time": { "type": "number" },
        "ctaUrl": { "type": "string", "maxLength": 500 },
        "ctaLabel": { "type": "string", "maxLength": 100 },
        "order": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["url", "folder", "name"]
    },
    "ShowcaseProduct": {
      "title": "ShowcaseProduct",
      "description": "Rural artisan or local business product showcase listing",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "price": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 100 },
        "artisanName": { "type": "string", "maxLength": 150 },
        "location": { "type": "string", "maxLength": 200 },
        "contactPhone": { "type": "string", "maxLength": 30 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "imageUrl", "artisanName"]
    },
    "GovernmentScheme": {
      "title": "GovernmentScheme",
      "description": "Admin-published government welfare or livelihood scheme card",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "hiName": { "type": "string", "maxLength": 200 },
        "benefit": { "type": "string", "maxLength": 500 },
        "eligibility": { "type": "string", "maxLength": 500 },
        "applyOffice": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["central", "state", "toolkit", "loan"] },
        "financialSupport": { "type": "string", "maxLength": 200 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "ctaUrl": { "type": "string", "maxLength": 500 },
        "ctaLabel": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "benefit"]
    },
    "SubAdmin": {
      "title": "SubAdmin",
      "description": "Authorized Gmail sub-administrator managed by the Super Admin",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "name": { "type": "string", "maxLength": 120 },
        "note": { "type": "string", "maxLength": 200 },
        "active": { "type": "boolean" },
        "addedBy": { "type": "string", "maxLength": 150 },
        "addedAt": { "type": "string", "maxLength": 64 },
        "lastLoginAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["email", "active", "addedBy", "addedAt"]
    },
    "AdminActivityLog": {
      "title": "AdminActivityLog",
      "description": "Immutable audit log entry recording add, update, and delete actions by admins and sub-admins",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 150 },
        "actorName": { "type": "string", "maxLength": 120 },
        "actorRole": { "type": "string", "enum": ["admin", "sub_admin"] },
        "action": { "type": "string", "enum": ["ADD", "UPDATE", "DELETE"] },
        "section": { "type": "string", "maxLength": 64 },
        "targetTitle": { "type": "string", "maxLength": 240 },
        "targetId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "timestampMs": { "type": "number" }
      },
      "required": ["actorEmail", "actorRole", "action", "section", "targetTitle", "createdAt", "timestampMs"]
    },
    "NotificationBroadcast": {
      "title": "NotificationBroadcast",
      "description": "Background push notification and alert broadcast sent to all citizens or a specific citizen",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "target": { "type": "string", "enum": ["all", "specific"] },
        "targetUserId": { "type": "string", "maxLength": 128 },
        "targetPhone": { "type": "string", "maxLength": 30 },
        "targetName": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 1000 },
        "url": { "type": "string", "maxLength": 300 },
        "sentBy": { "type": "string", "maxLength": 150 },
        "pushDeliveredCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "timestampMs": { "type": "number" }
      },
      "required": ["id", "target", "title", "body", "createdAt", "timestampMs"]
    },
    "PushSubscriptionRecord": {
      "title": "PushSubscriptionRecord",
      "description": "Citizen Web Push subscription record for background PWA and browser notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "endpoint": { "type": "string", "maxLength": 1000 },
        "uid": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 30 },
        "name": { "type": "string", "maxLength": 150 },
        "location": { "type": "string", "maxLength": 200 },
        "isStandalone": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "endpoint", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with personal and livelihood preferences"
    },
    "/opportunities/{opportunityId}": {
      "schema": "Opportunity",
      "description": "Public verified job and self-employment opportunities"
    },
    "/training_centers/{centerId}": {
      "schema": "TrainingCenter",
      "description": "Public accredited skill development centers and institutes"
    },
    "/pathways/{pathwayId}": {
      "schema": "Pathway",
      "description": "Curated NSQF career progression pathways"
    },
    "/media/{mediaId}": {
      "schema": "MediaAsset",
      "description": "Admin-uploaded Cloudinary media assets, hero banners, training gallery, and general/scheme banners"
    },
    "/showcase/{productId}": {
      "schema": "ShowcaseProduct",
      "description": "Local business and rural artisan showcase products"
    },
    "/schemes/{schemeId}": {
      "schema": "GovernmentScheme",
      "description": "Government schemes and grant listings"
    },
    "/sub_admins/{emailKey}": {
      "schema": "SubAdmin",
      "description": "Authorized sub-admin accounts keyed by normalized lowercase Gmail address"
    },
    "/admin_activity_logs/{logId}": {
      "schema": "AdminActivityLog",
      "description": "Immutable audit trail of admin and sub-admin additions, edits, and deletions"
    },
    "/notifications/{notificationId}": {
      "schema": "NotificationBroadcast",
      "description": "Broadcast and targeted push notifications delivered to registered citizens and PWAs"
    },
    "/push_subscriptions/{subscriptionId}": {
      "schema": "PushSubscriptionRecord",
      "description": "Web Push subscriptions registered by citizen browsers and installed PWAs"
    }
  }
}
